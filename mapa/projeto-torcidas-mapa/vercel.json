{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/mapa/(.*)",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/mapa",
      "destination": "/mapa/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/mapa/index.html"
    }
  ]
}
