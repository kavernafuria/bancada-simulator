{
  "buildCommand": "cd mapa/projeto-torcidas-mapa && npm install && npm run build",
  "outputDirectory": "mapa/projeto-torcidas-mapa/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/mapa/projeto-torcidas-mapa/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
